# Обязательны поля

BOT_TOKEN=""
# Токен первого администратора. После старта он создаёт аккаунты работодателей
ADMIN_API_TOKEN=""
EMPLOYER_API_PORT=

POSTGRES_DB=""
POSTGRES_USER=""
POSTGRES_PASSWORD=""
POSTGRES_PORT=
POSTGRES_DB_TEST=${POSTGRES_DB}_test
POSTGRES_USER_TEST=${POSTGRES_USER}_test
POSTGRES_PASSWORD_TEST=${POSTGRES_PASSWORD}_test

# Опциональные поля
# Origin веб-формы работодателя, например http://localhost:3000
EMPLOYER_ALLOWED_ORIGIN="*"
# Еженедельные напоминания по активному roadmap.
REMINDERS_ENABLED=true
REMINDER_CRON="0 10 * * 1"
REMINDER_TIMEZONE=Europe/Moscow

# Нужны только при запуске приложения не через docker compose
DB_HOST=localhost
DB_PORT=5432
DB_NAME=employer_first_roadmap
DB_USER=efr
DB_PASSWORD=efr_local_password
DB_SSLMODE=disable
